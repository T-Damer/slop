{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "useDefineForClassFields": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "typeRoots": [
      ".modoki-engine/node_modules/@types"
    ]
  },
  "include": [
    "games/traffic-jam/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "games/traffic-jam/dist",
    "games/traffic-jam/node_modules"
  ]
}
