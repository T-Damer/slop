{
  "schemaVersion": 1,
  "maxBranches": 5,
  "maxFeatureBranches": 3,
  "maxOpenPullRequests": 3,
  "permanentBranches": ["main", "stable"],
  "featureZones": [
    {
      "branch": "docs/agent-foundation",
      "responsibility": "foundation-runtime",
      "paths": [
        "AGENTS.md",
        ".github/**",
        ".slop/**",
        ".gitignore",
        ".mcp.json",
        "addons/**",
        "docs/**",
        "games/traffic-jam/**",
        "packages/**",
        "server/**",
        "tools/**",
        "web/**",
        "project.godot",
        "export_presets.cfg",
        "package.json",
        "package-lock.json",
        "tsconfig*.json",
        "docker-compose.yml"
      ]
    }
  ]
}
