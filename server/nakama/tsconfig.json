{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES5",
    "module": "ES2020",
    "moduleResolution": "Bundler",
    "rootDir": "../..",
    "outDir": ".compiled",
    "declaration": false,
    "sourceMap": false,
    "types": []
  },
  "include": [
    "src/**/*.ts",
    "types/**/*.d.ts",
    "../../packages/**/*.ts",
    "../../games/traffic-jam/domain/**/*.ts"
  ],
  "exclude": [
    "../../packages/**/*.test.ts",
    "../../games/**/domain/**/*.test.ts"
  ]
}
